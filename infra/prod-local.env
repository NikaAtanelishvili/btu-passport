# Local production rehearsal (make prod-up): read after .env.demo, so these win. The stack
# answers at http://localhost:3000; Google sign-in uses the dev redirect URI
# http://localhost:3000/auth/google/callback.
PUBLIC_BASE_URL=http://localhost:3000
# Browsers refuse the demo's __Host-session over http, even on localhost (Chrome:
# InvalidPrefix), so sign-in never stuck. A plain name still Secure (localhost is a secure
# context), and not the dev stack's `session`, which shares the host localhost.
SESSION_COOKIE_NAME=passport_session
SITE_ADDRESS=http://:3000
CADDY_HTTP_BIND=127.0.0.1:3000:3000
CADDY_HTTPS_BIND=127.0.0.1:3443:443
