# Local production rehearsal (make prod-up): read after .env.demo, so these win. The stack
# answers at http://localhost:3000; browsers accept the demo's Secure __Host- cookie on
# localhost, and Google sign-in uses the dev redirect URI http://localhost:3000/auth/google/callback.
PUBLIC_BASE_URL=http://localhost:3000
SITE_ADDRESS=http://:3000
CADDY_HTTP_BIND=127.0.0.1:3000:3000
CADDY_HTTPS_BIND=127.0.0.1:3443:443
