{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/signer.Dockerfile",
    "watchPatterns": ["backend/signer/**", "backend/pyproject.toml", "backend/uv.lock", "shared/**", "contracts/deployments/**"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
