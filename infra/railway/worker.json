{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": ["backend/**", "shared/**", "contracts/deployments/**", "seed/**"]
  },
  "deploy": {
    "startCommand": "python -m worker",
    "restartPolicyType": "ALWAYS"
  }
}
