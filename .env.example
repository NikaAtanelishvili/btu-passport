# BTU AI Skills Passport — environment (IN-02, Overview §4).
# Copy to .env (git-ignored) and fill the `change-me` values.
# Values marked DEV ONLY are local-only defaults or Anvil's *published* test keys;
# never use them outside a local Anvil chain.

# --- General ---------------------------------------------------------------
# dev | test | demo
ENV=dev
TIMEZONE=Asia/Tbilisi
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (api, worker, cli) -------------------------------------------
# DEV ONLY
DATABASE_URL=postgresql+psycopg://passport:passport@localhost:5432/passport
# Tests use the database passport_test on the same server.

# --- Object storage: MinIO (api, worker) -----------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# DEV ONLY
S3_ACCESS_KEY=minio
# DEV ONLY
S3_SECRET_KEY=minio-secret
S3_BUCKET=passports

# --- Email: sign-in codes and version notices (api, worker; BE-10 / IN-04) ---
# smtp (dev: Mailpit, inbox UI at http://localhost:8025) | resend (Resend's HTTP API; demo,
# because Railway blocks outbound SMTP)
MAIL_PROVIDER=smtp
# sender address (SMTP_FROM, its old name, is still accepted)
MAIL_FROM=passport@btu.test
# MAIL_PROVIDER=resend only; the API refuses to start without it then
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- Email-code sign-in (api, BE-10) ---------------------------------------
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
# code requests per hour; over the limit returns 429
LOGIN_RATE_PER_EMAIL_HOUR=5
LOGIN_RATE_PER_IP_HOUR=20
# also print codes to the API log; refused unless ENV is dev or test
DEV_LOG_LOGIN_CODES=true
ALLOWED_EMAIL_DOMAINS=btu.edu.ge,btu.test,example.org
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@btu.test
# dev only: also SUPER_ADMIN after `make bootstrap` (comma-separated; each must be on an
# allowed domain or in ALLOWED_EMAILS), e.g. your own Gmail for Sign in with Google
DEV_SUPER_ADMIN_EMAILS=
# Demo accounts with real inboxes (`make demo-users`). Set these in .env.demo only, together
# with ALLOWED_EMAIL_DOMAINS extended by their domains; empty in dev.
DEMO_SUPER_ADMIN_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_ID=BTU-T-0900
DEMO_STUDENT_FIRST_NAME=Demo
DEMO_STUDENT_LAST_NAME=Student

# --- Sign in with Google (api, BE-15) --------------------------------------
# OAuth client (type "Web application") from Google Cloud; README "Sign in with Google".
# Empty client ID = the button is hidden and /auth/google/* return 404. Secret: .env only.
# Redirect URI to register: PUBLIC_BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact addresses that may sign in with Google although their domain isn't in
# ALLOWED_EMAIL_DOMAINS (comma-separated exceptions; dev: your own Gmail). Empty by default.
ALLOWED_EMAILS=

# --- Sessions (api, NFR-04) ------------------------------------------------
# demo: __Host-session
SESSION_COOKIE_NAME=session
# demo: true (needs HTTPS)
SESSION_SECURE=false
SESSION_ABSOLUTE_HOURS=8
ADMIN_IDLE_MINUTES=30

# --- Chain (api, worker, signer) -------------------------------------------
CHAIN_ID=31337
RPC_URL=http://localhost:8545
# written by `make chain-deploy` from contracts/deployments/31337.json
CONTRACT_ADDRESS=
# DEV ONLY: Anvil account 0
ISSUER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# --- Signer (worker, signer) -----------------------------------------------
SIGNER_URL=http://localhost:8100
# 32 random bytes, e.g. `openssl rand -hex 32`
SIGNER_HMAC_SECRET=change-me
# signer only; dev: Anvil account 0's published key
ISSUER_PRIVATE_KEY_FILE=secrets/issuer_key
# signer only: blocks to wait after the receipt (BC-07)
CONFIRMATIONS=1

# --- Anchoring (worker) ----------------------------------------------------
# production would use 600
ANCHOR_INTERVAL_SECONDS=10
BATCH_MAX_LEAVES=1024
ANCHOR_MAX_ATTEMPTS=5

# --- PDF (worker) ----------------------------------------------------------
PASSPORT_TEMPLATE_DIR=app/pdf/templates

# --- Google Sheets intake (api, worker, cli; M11) ---------------------------
# The Sheet's ID from its URL (between /d/ and /edit); empty = no scheduled sync
GOOGLE_SHEETS_ID=
# Service account key: a file (relative to the repo root) or, on a host without files,
# the key's JSON content. Never committed; secrets/ is git-ignored.
GOOGLE_SHEETS_CREDENTIALS_FILE=secrets/google-sheets-sa.json
GOOGLE_SHEETS_CREDENTIALS_JSON=
SHEET_SYNC_INTERVAL_SECONDS=60
# true: write sync_status, sync_message, synced_at on the Verified Skills tab (needs Editor)
SHEET_WRITEBACK=false

# --- Web (Next.js) ---------------------------------------------------------
# server side: target of the rewrites
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_EXPLORER_TX_URL=

# --- make chain-deploy only (never read by any service) ---------------------
# DEV ONLY: Anvil account 0 (published)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ETHERSCAN_API_KEY=
