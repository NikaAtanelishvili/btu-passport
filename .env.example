# BTU AI Skills Passport — environment (IN-02, Overview §4).
# Copy to .env (git-ignored) and fill the `change-me` values.
# Values marked DEV ONLY are local-only defaults or Anvil's *published* test keys;
# never use them outside a local Anvil chain.
#
# Demo / production (M10): the same variables go into .env.demo (git-ignored) for the
# local prod rehearsal and the plain server, or into each Railway service's Variables.
# Lines starting with "# demo:" give the demo value; README "Railway deploy" and "Plain
# server deploy" say which service needs which variable. Config comes only from the
# environment; inside the containers there is no .env file.

# --- General ---------------------------------------------------------------
# dev | test | demo. demo: demo. With ENV=demo the API, worker and CLI refuse to start
# unless SESSION_SECURE=true, DEV_LOG_LOGIN_CODES=false and ALLOWED_EMAILS is empty.
ENV=dev
TIMEZONE=Asia/Tbilisi
# demo: https://btuaipassport.space (the local prod rehearsal overrides it with
# http://localhost:3000, see infra/prod-local.env)
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (api, worker, cli) -------------------------------------------
# DEV ONLY. postgresql:// and postgres:// URLs (Railway's) get the psycopg driver added.
# demo: Railway: ${{Postgres.DATABASE_URL}}; compose (prod): set by the compose file.
DATABASE_URL=postgresql+psycopg://passport:passport@localhost:5432/passport
# compose prod stack only: the Postgres container's password (any long random string)
POSTGRES_PASSWORD=change-me
# Tests use the database passport_test on the same server.

# --- Object storage: MinIO or any S3 bucket (api, worker) --------------------
# demo: Railway: the bucket's endpoint, keys and name (its Credentials tab); compose (prod):
# the MinIO container (endpoint set by the compose file; S3_ACCESS_KEY / S3_SECRET_KEY
# become MinIO's root user and password there, so pick long random values)
S3_ENDPOINT_URL=http://localhost:9000
# DEV ONLY
S3_ACCESS_KEY=minio
# DEV ONLY
S3_SECRET_KEY=minio-secret
S3_BUCKET=passports
# MinIO: us-east-1 and path. Railway's bucket: its region and, if path style is refused,
# virtual
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

# --- Email: sign-in codes and version notices (api, worker; BE-10 / IN-04) ---
# smtp (dev: Mailpit, inbox UI at http://localhost:8025) | resend (Resend's HTTP API; demo,
# because Railway blocks outbound SMTP)
# demo: resend
MAIL_PROVIDER=smtp
# sender address (SMTP_FROM, its old name, is still accepted). demo: passport@btuaipassport.space
MAIL_FROM=passport@btu.test
# MAIL_PROVIDER=resend only; the API refuses to start without it then
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- Email-code sign-in (api, BE-10) ---------------------------------------
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
# code requests per hour; over the limit returns 429
LOGIN_RATE_PER_EMAIL_HOUR=5
LOGIN_RATE_PER_IP_HOUR=20
# also print codes to the API log; refused unless ENV is dev or test. demo: false
DEV_LOG_LOGIN_CODES=true
# demo: btu.edu.ge,gmail.com
ALLOWED_EMAIL_DOMAINS=btu.edu.ge,btu.test,example.org
# demo: not used (the demo super admin comes from DEMO_SUPER_ADMIN_EMAIL)
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@btu.test
# dev only: also SUPER_ADMIN after `make bootstrap` (comma-separated; each must be on an
# allowed domain or in ALLOWED_EMAILS), e.g. your own Gmail for Sign in with Google
DEV_SUPER_ADMIN_EMAILS=
# Demo accounts with real inboxes (`python -m cli demo-users`). Set these in the demo env
# only (their domains must be in ALLOWED_EMAIL_DOMAINS); empty in dev.
DEMO_SUPER_ADMIN_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_ID=BTU-T-0900
DEMO_STUDENT_FIRST_NAME=Demo
DEMO_STUDENT_LAST_NAME=Student

# --- Sign in with Google (api, BE-15) --------------------------------------
# OAuth client (type "Web application") from Google Cloud; README "Sign in with Google".
# Empty client ID = the button is hidden and /auth/google/* return 404. Secret: .env only.
# Redirect URI to register: PUBLIC_BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact addresses that may sign in with Google although their domain isn't in
# ALLOWED_EMAIL_DOMAINS (comma-separated exceptions; dev: your own Gmail). Empty by default.
# demo: must stay empty
ALLOWED_EMAILS=

# --- Sessions (api, NFR-04) ------------------------------------------------
# demo: __Host-session
SESSION_COOKIE_NAME=session
# demo: true (needs HTTPS; browsers also accept it on http://localhost)
SESSION_SECURE=false
SESSION_ABSOLUTE_HOURS=8
ADMIN_IDLE_MINUTES=30

# --- Chain (api, worker, signer) -------------------------------------------
# demo: 11155111 (Sepolia)
CHAIN_ID=31337
# demo: a Sepolia RPC with your provider key (server side only, never shown to browsers)
RPC_URL=http://localhost:8545
# written by `make chain-deploy` from contracts/deployments/<chainId>.json
# (demo: by `make chain-deploy-sepolia` into .env.demo)
CONTRACT_ADDRESS=
# DEV ONLY: Anvil account 0. demo: the address of the Sepolia issuer key
ISSUER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# --- Signer (worker, signer) -----------------------------------------------
# demo: Railway: http://signer.railway.internal:8100; compose (prod): set by the compose file
SIGNER_URL=http://localhost:8100
# 32 random bytes, e.g. `openssl rand -hex 32`
SIGNER_HMAC_SECRET=change-me
# signer only; dev: Anvil account 0's published key. demo: secrets/issuer_key_sepolia
# (compose mounts it as a secret into the signer container only)
ISSUER_PRIVATE_KEY_FILE=secrets/issuer_key
# signer only: the key itself instead of a file (Railway: set on the signer service only,
# never in a shared env file). Wins over the file when set.
ISSUER_PRIVATE_KEY=
# signer only: blocks to wait after the receipt (BC-07)
CONFIRMATIONS=1

# --- Anchoring (worker) ----------------------------------------------------
# production would use 600; demo: 30 (each batch is a Sepolia transaction)
ANCHOR_INTERVAL_SECONDS=10
BATCH_MAX_LEAVES=1024
ANCHOR_MAX_ATTEMPTS=5

# --- PDF (worker) ----------------------------------------------------------
PASSPORT_TEMPLATE_DIR=app/pdf/templates

# --- Google Sheets intake (api, worker, cli; M11) ---------------------------
# The Sheet's ID from its URL (between /d/ and /edit); empty = no scheduled sync
GOOGLE_SHEETS_ID=
# Service account key: a file (relative to the repo root) or, on a host without files,
# the key's JSON content. Never committed; secrets/ is git-ignored.
# demo: Railway: GOOGLE_SHEETS_CREDENTIALS_JSON (the whole JSON, one line); compose (prod):
# the file, mounted read-only into api and worker
GOOGLE_SHEETS_CREDENTIALS_FILE=secrets/google-sheets-sa.json
GOOGLE_SHEETS_CREDENTIALS_JSON=
SHEET_SYNC_INTERVAL_SECONDS=60
# true: write sync_status, sync_message, synced_at on the Verified Skills tab (needs Editor)
# demo: true
SHEET_WRITEBACK=false

# --- Containers (M10) --------------------------------------------------------
# Listen address and port of api / signer / web in their images. Railway: HOST=:: on api
# and signer (its private network is IPv6), PORT 8000 / 8100 / 3000.
# HOST=
# PORT=
# worker container only: healthy while this file keeps being touched (/tmp/worker-alive)
# WORKER_HEARTBEAT_FILE=
# compose prod stack only (infra/docker-compose.prod.yml): Caddy's site address and the
# host ports it publishes. Server: btuaipassport.space with 80:80 / 443:443 (defaults);
# the local rehearsal sets http://:3000 and 127.0.0.1 binds in infra/prod-local.env.
# SITE_ADDRESS=
# CADDY_HTTP_BIND=
# CADDY_HTTPS_BIND=

# --- Web (Next.js) ---------------------------------------------------------
# All but TRUSTED_EDGE_PROXY are fixed at `next build`: build arguments of web/Dockerfile
# (Railway passes the web service's variables to the build), together with CHAIN_ID,
# CONTRACT_ADDRESS and ISSUER_ADDRESS (BTU's issuer identity for the verify page).
# server side: target of the rewrites. demo: Railway: http://api.railway.internal:8000;
# compose: http://api:8000
API_ORIGIN=http://localhost:8000
# read by browsers, so a public RPC without a key.
# demo: https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=http://localhost:8545
# demo: https://sepolia.etherscan.io/tx/
NEXT_PUBLIC_EXPLORER_TX_URL=
# web, run time: true behind a host's edge proxy that appends the client address to
# X-Forwarded-For (Railway). Otherwise client-sent forwarding headers are dropped.
TRUSTED_EDGE_PROXY=false

# --- make chain-deploy only (never read by any service) ---------------------
# DEV ONLY: Anvil account 0 (published). Sepolia: `make chain-deploy-sepolia` reads the key
# from ISSUER_PRIVATE_KEY_FILE in .env.demo instead; never put a real key here.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ETHERSCAN_API_KEY=
