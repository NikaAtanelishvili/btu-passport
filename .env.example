# BTU AI Skills Passport — environment (IN-02, Overview §4).
# Copy to .env (git-ignored) and fill the `change-me` values.
# Values marked DEV ONLY are local-only defaults or Anvil's *published* test keys;
# never use them outside a local Anvil chain.

# --- General ---------------------------------------------------------------
# dev | test | demo
ENV=dev
TIMEZONE=Asia/Tbilisi
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (api, worker, cli) -------------------------------------------
# DEV ONLY
DATABASE_URL=postgresql+psycopg://passport:passport@localhost:5432/passport
# Tests use the database passport_test on the same server.

# --- Object storage: MinIO (api, worker) -----------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# DEV ONLY
S3_ACCESS_KEY=minio
# DEV ONLY
S3_SECRET_KEY=minio-secret
S3_BUCKET=passports

# --- Sign-in email (api, BE-10 / IN-04) -------------------------------------
# dev: Mailpit (inbox UI at http://localhost:8025); demo: a real SMTP sender
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=passport@btu.test

# --- Email-code sign-in (api, BE-10) ---------------------------------------
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
# code requests per hour; over the limit returns 429
LOGIN_RATE_PER_EMAIL_HOUR=5
LOGIN_RATE_PER_IP_HOUR=20
# also print codes to the API log; refused unless ENV is dev or test
DEV_LOG_LOGIN_CODES=true
ALLOWED_EMAIL_DOMAINS=btu.edu.ge,btu.test,example.org
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@btu.test

# --- Sessions (api, NFR-04) ------------------------------------------------
# demo: __Host-session
SESSION_COOKIE_NAME=session
# demo: true (needs HTTPS)
SESSION_SECURE=false
SESSION_ABSOLUTE_HOURS=8
ADMIN_IDLE_MINUTES=30

# --- Chain (api, worker, signer) -------------------------------------------
CHAIN_ID=31337
RPC_URL=http://localhost:8545
# written by `make chain-deploy` from contracts/deployments/31337.json
CONTRACT_ADDRESS=
# DEV ONLY: Anvil account 0
ISSUER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# --- Signer (worker, signer) -----------------------------------------------
SIGNER_URL=http://localhost:8100
# 32 random bytes, e.g. `openssl rand -hex 32`
SIGNER_HMAC_SECRET=change-me
# signer only; dev: Anvil account 0's published key
ISSUER_PRIVATE_KEY_FILE=secrets/issuer_key

# --- Anchoring (worker) ----------------------------------------------------
# production would use 600
ANCHOR_INTERVAL_SECONDS=10
BATCH_MAX_LEAVES=1024
ANCHOR_MAX_ATTEMPTS=5

# --- PDF (worker) ----------------------------------------------------------
PASSPORT_TEMPLATE_DIR=app/pdf/templates

# --- Web (Next.js) ---------------------------------------------------------
# server side: target of the rewrites
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_EXPLORER_TX_URL=

# --- make chain-deploy only (never read by any service) ---------------------
# DEV ONLY: Anvil account 0 (published)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ETHERSCAN_API_KEY=
